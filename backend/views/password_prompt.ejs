<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Protected Link · All in1 url</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      min-height: 100vh;
      background-color: #020617;
      background-image:
        radial-gradient(ellipse 70% 40% at 50% 0%, rgba(139,92,246,0.13) 0%, transparent 70%),
        radial-gradient(circle, rgba(139,92,246,0.05) 1px, transparent 1px);
      background-size: 100% 100%, 28px 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px;
      color: #f8fafc;
    }

    .logo-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 28px;
    }
    .logo-icon {
      width: 28px; height: 28px;
      border-radius: 8px;
      background: #7c3aed;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .logo-icon svg { width: 16px; height: 16px; stroke: white; fill: none; }
    .logo-bar span { font-size: 13px; font-weight: 600; color: #94a3b8; }

    .card {
      width: 100%; max-width: 380px;
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 20px;
      box-shadow: 0 25px 50px rgba(0,0,0,0.5);
      overflow: hidden;
    }

    .card-header {
      padding: 28px 28px 24px;
      text-align: center;
      border-bottom: 1px solid #1e293b;
    }
    .lock-wrap {
      width: 56px; height: 56px;
      border-radius: 16px;
      background: rgba(139,92,246,0.1);
      border: 1px solid rgba(139,92,246,0.2);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
    }
    .lock-wrap svg { width: 26px; height: 26px; stroke: #a78bfa; fill: none; }
    .card-header h1 { font-size: 18px; font-weight: 700; color: #f8fafc; margin-bottom: 6px; }
    .card-header p { font-size: 13px; color: #94a3b8; line-height: 1.6; }

    .card-body { padding: 24px 28px; }

    .error-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: rgba(127,29,29,0.3);
      border: 1px solid rgba(239,68,68,0.3);
      border-radius: 12px;
      margin-bottom: 16px;
    }
    .error-box svg { width: 15px; height: 15px; stroke: #f87171; fill: none; flex-shrink: 0; }
    .error-box span { font-size: 13px; color: #f87171; }

    label {
      display: block;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.07em;
      color: #64748b;
      margin-bottom: 8px;
    }

    .input-wrap { position: relative; margin-bottom: 20px; }
    .input-wrap input {
      width: 100%;
      padding: 12px 44px 12px 16px;
      background: #1e293b;
      border: 2px solid #334155;
      border-radius: 12px;
      font-size: 14px; color: #f8fafc;
      outline: none;
      transition: border-color 0.2s;
    }
    .input-wrap input::placeholder { color: #475569; }
    .input-wrap input:focus { border-color: #7c3aed; }

    .toggle-pw {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #475569; display: flex; align-items: center; padding: 2px;
      transition: color 0.15s;
    }
    .toggle-pw:hover { color: #94a3b8; }
    .toggle-pw svg { width: 16px; height: 16px; stroke: currentColor; fill: none; }

    .submit-btn {
      width: 100%;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 13px 20px;
      background: #7c3aed; color: white;
      font-size: 14px; font-weight: 600;
      border: none; border-radius: 12px;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      box-shadow: 0 4px 20px rgba(124,58,237,0.3);
    }
    .submit-btn:hover:not(:disabled) { background: #6d28d9; }
    .submit-btn:active:not(:disabled) { transform: scale(0.99); }
    .submit-btn:disabled { background: #1e293b; color: #475569; cursor: not-allowed; box-shadow: none; }
    .submit-btn svg { width: 16px; height: 16px; stroke: currentColor; fill: none; flex-shrink: 0; }

    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.25);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      flex-shrink: 0;
    }

    .back-link {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin-top: 18px;
      font-size: 13px; color: #475569; text-decoration: none;
      transition: color 0.15s;
    }
    .back-link:hover { color: #94a3b8; }
    .back-link svg { width: 13px; height: 13px; stroke: currentColor; fill: none; }

    .footer-note { margin-top: 24px; font-size: 12px; color: #1e293b; text-align: center; }
    .footer-note a { color: #334155; text-decoration: none; transition: color 0.15s; }
    .footer-note a:hover { color: #475569; }
  </style>
</head>
<body>

  <div class="logo-bar">
    <div class="logo-icon">
      <svg viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
    </div>
    <span>All in1 url</span>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="lock-wrap">
        <svg viewBox="0 0 24 24" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h1>Protected Link</h1>
      <p>This link requires a password.<br/>Enter it below to continue.</p>
    </div>

    <div class="card-body">

      <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-box">
        <svg viewBox="0 0 24 24" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span><%= error %></span>
      </div>
      <% } %>

      <form method="POST" action="/link/verify-password" id="pwForm">
        <input type="hidden" name="hashedUsername" value="<%= hashedUsername %>" />
        <input type="hidden" name="hashedSource" value="<%= hashedSource %>" />

        <label for="password">Password</label>
        <div class="input-wrap">
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter password"
            autocomplete="current-password"
            autofocus
            required
          />
          <button type="button" class="toggle-pw" id="togglePw" tabindex="-1" aria-label="Show/hide password">
            <svg id="eyeOn" viewBox="0 0 24 24" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <svg id="eyeOff" viewBox="0 0 24 24" stroke-width="2" style="display:none">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </button>
        </div>

        <button type="submit" class="submit-btn" id="submitBtn">
          <svg id="btnIcon" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <span id="btnText">Access Link</span>
        </button>
      </form>

    </div>
  </div>

  <a href="javascript:history.back()" class="back-link">
    <svg viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    Go back
  </a>

  <p class="footer-note">
    Secured by <a href="https://allin1url.in" target="_blank" rel="noopener noreferrer">All in1 url</a>
  </p>

  <script>
    const pwInput  = document.getElementById('password');
    const submitBtn = document.getElementById('submitBtn');
    const btnIcon  = document.getElementById('btnIcon');
    const btnText  = document.getElementById('btnText');
    const togglePw = document.getElementById('togglePw');
    const eyeOn    = document.getElementById('eyeOn');
    const eyeOff   = document.getElementById('eyeOff');

    togglePw.addEventListener('click', () => {
      const show = pwInput.type === 'password';
      pwInput.type = show ? 'text' : 'password';
      eyeOn.style.display  = show ? 'none' : '';
      eyeOff.style.display = show ? '' : 'none';
    });

    document.getElementById('pwForm').addEventListener('submit', () => {
      submitBtn.disabled = true;
      btnIcon.outerHTML  = '<div class="spinner"></div>';
      btnText.textContent = 'Verifying...';
    });
  </script>

</body>
</html>
