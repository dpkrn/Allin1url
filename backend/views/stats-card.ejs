<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>AllIn1URL Stats</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:transparent;display:flex;align-items:flex-start;justify-content:flex-start}
    .card{
      width:495px;
      background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%);
      border:1px solid #334155;border-radius:12px;overflow:hidden;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    }
    .header{
      display:flex;align-items:center;gap:8px;
      padding:14px 18px 10px;
      border-bottom:1px solid #1e293b;
      background:linear-gradient(90deg,rgba(124,58,237,.12) 0%,transparent 100%);
    }
    .dot{width:9px;height:9px;border-radius:50%;background:#7c3aed;flex-shrink:0}
    .brand-name{font-size:13px;font-weight:700;color:#e2e8f0}
    .brand-sub{font-size:11px;color:#a78bfa;margin-left:2px}
    .live{margin-left:auto;font-size:9px;font-weight:600;color:#10b981;
      background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);
      border-radius:20px;padding:1px 7px;letter-spacing:.6px;text-transform:uppercase}
    .stats{display:grid;grid-template-columns:repeat(3,1fr)}
    .stat{padding:18px 10px 14px;text-align:center;position:relative}
    .stat+.stat::before{
      content:'';position:absolute;left:0;top:12px;bottom:12px;
      width:1px;background:#1e293b;
    }
    .val{
      font-size:26px;font-weight:800;line-height:1;margin-bottom:6px;
      letter-spacing:-1px;
    }
    .stat:nth-child(1) .val{color:#a78bfa}
    .stat:nth-child(2) .val{color:#38bdf8}
    .stat:nth-child(3) .val{color:#34d399}
    .lbl{font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:.4px;font-weight:500}
    .footer{
      border-top:1px solid #1e293b;padding:7px;
      text-align:center;font-size:10px;color:#475569;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <div class="dot"></div>
      <span class="brand-name">AllIn1URL</span>
      <span class="brand-sub">– Link in Bio Platform</span>
      <span class="live">live</span>
    </div>
    <div class="stats">
      <div class="stat">
        <div class="val" data-target="<%= totalUsers %>">0</div>
        <div class="lbl">Registered Users</div>
      </div>
      <div class="stat">
        <div class="val" data-target="<%= totalVisitors %>">0</div>
        <div class="lbl">Total Visitors</div>
      </div>
      <div class="stat">
        <div class="val" data-target="<%= totalLinks %>">0</div>
        <div class="lbl">Links Created</div>
      </div>
    </div>
    <div class="footer">
      allin1url.in &middot; updated <span id="ts"></span>
    </div>
  </div>

  <script>
    const fmt = n => n >= 1e6 ? (n/1e6).toFixed(1).replace(/\.0$/,'')+'M'
                   : n >= 1e3 ? (n/1e3).toFixed(1).replace(/\.0$/,'')+'K'
                   : String(n);
    document.querySelectorAll('.val').forEach(el => {
      const target = parseInt(el.dataset.target, 10) || 0;
      const start = performance.now();
      const step = now => {
        const p = Math.min((now - start) / 1000, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(Math.floor(ease * target));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
    document.getElementById('ts').textContent = new Date().toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
    setTimeout(() => location.reload(), 60000);
  </script>
</body>
</html>
