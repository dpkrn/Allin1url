<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%=username.toUpperCase()%>'s All in1 url profile">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <title><%=username.toUpperCase()%> - All in1 url</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Roboto Slab', serif;
            background: linear-gradient(180deg, #1a2332 0%, #2d3a4a 25%, #3d4a5a 50%, #4a5a6a 65%, #87ceeb 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .mountain-range {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 60%;
            z-index: 0;
            overflow: hidden;
        }
        
        .mountain {
            position: absolute;
            bottom: 0;
            width: 0;
            height: 0;
            border-left: 200px solid transparent;
            border-right: 200px solid transparent;
            border-bottom: 300px solid rgba(70, 90, 110, 0.6);
            animation: mountainShift 20s ease-in-out infinite;
        }
        
        .mountain1 {
            left: -100px;
            border-bottom-color: rgba(60, 80, 100, 0.7);
            animation-delay: 0s;
        }
        
        .mountain2 {
            left: 150px;
            border-bottom-color: rgba(70, 90, 110, 0.6);
            animation-delay: 2s;
            transform: scale(0.9);
        }
        
        .mountain3 {
            left: 400px;
            border-bottom-color: rgba(80, 100, 120, 0.5);
            animation-delay: 4s;
            transform: scale(0.8);
        }
        
        .mountain4 {
            left: 650px;
            border-bottom-color: rgba(70, 90, 110, 0.6);
            animation-delay: 1s;
            transform: scale(0.85);
        }
        
        @keyframes mountainShift {
            0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
            50% { transform: translateY(-10px) scale(1.02); opacity: 0.8; }
        }
        
        .snow-caps {
            position: fixed;
            bottom: 60%;
            left: 0;
            width: 100%;
            height: 10%;
            z-index: 0;
        }
        
        .snow {
            position: absolute;
            width: 6px;
            height: 6px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 50%;
            animation: snowFall linear infinite;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
        }
        
        .snow:nth-child(1) { left: 10%; animation-duration: 8s; animation-delay: 0s; }
        .snow:nth-child(2) { left: 25%; animation-duration: 10s; animation-delay: 2s; }
        .snow:nth-child(3) { left: 40%; animation-duration: 12s; animation-delay: 4s; }
        .snow:nth-child(4) { left: 55%; animation-duration: 9s; animation-delay: 1s; }
        .snow:nth-child(5) { left: 70%; animation-duration: 11s; animation-delay: 3s; }
        .snow:nth-child(6) { left: 85%; animation-duration: 13s; animation-delay: 5s; }
        .snow:nth-child(7) { left: 15%; animation-duration: 14s; animation-delay: 6s; }
        .snow:nth-child(8) { left: 30%; animation-duration: 15s; animation-delay: 7s; }
        
        @keyframes snowFall {
            0% {
                top: -10%;
                transform: translateX(0);
                opacity: 1;
            }
            100% {
                top: 100%;
                transform: translateX(50px);
                opacity: 0;
            }
        }
        
        .clouds {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 40%;
            z-index: 0;
        }
        
        .cloud {
            position: absolute;
            width: 100px;
            height: 40px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50px;
            animation: cloudMove linear infinite;
        }
        
        .cloud::before {
            content: '';
            position: absolute;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            top: -25px;
            left: 10px;
        }
        
        .cloud::after {
            content: '';
            position: absolute;
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            top: -30px;
            right: 10px;
        }
        
        .cloud1 {
            top: 10%;
            animation-duration: 30s;
            animation-delay: 0s;
        }
        
        .cloud2 {
            top: 20%;
            animation-duration: 35s;
            animation-delay: 5s;
        }
        
        .cloud3 {
            top: 15%;
            animation-duration: 40s;
            animation-delay: 10s;
        }
        
        @keyframes cloudMove {
            0% { left: -150px; }
            100% { left: 100%; }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            max-height: 95vh;
            background: rgba(26, 35, 50, 0.6);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 25px 30px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.6),
                0 0 50px rgba(135, 206, 235, 0.3),
                inset 0 0 40px rgba(70, 90, 110, 0.2);
            border: 2px solid rgba(135, 206, 235, 0.4);
            animation: mountainFloat 8s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes mountainFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(135, 206, 235, 0.7);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.6),
                0 0 40px rgba(135, 206, 235, 0.5),
                inset 0 0 30px rgba(70, 90, 110, 0.3);
            margin-bottom: 25px;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: picElevate 4s ease-in-out infinite;
        }
        
        @keyframes picElevate {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-8px) scale(1.05); }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.7),
                0 0 60px rgba(135, 206, 235, 0.7),
                inset 0 0 50px rgba(70, 90, 110, 0.4);
        }
        
        .username {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 12px;
            text-shadow: 
                0 4px 20px rgba(0, 0, 0, 0.7),
                0 0 30px rgba(135, 206, 235, 0.5);
            animation: usernamePeak 3s ease-in-out infinite;
            letter-spacing: 2px;
        }
        
        @keyframes usernamePeak {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        
        .bio {
            font-size: 16px;
            color: rgba(200, 220, 240, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.5);
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 16px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(135, 206, 235, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(135, 206, 235, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(135, 206, 235, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(40px) scale(0.9);
            animation: mountainRise 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes mountainRise {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(70, 90, 110, 0.4);
            border: 2px solid rgba(135, 206, 235, 0.5);
            border-radius: 18px;
            text-decoration: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.5),
                0 0 30px rgba(135, 206, 235, 0.2),
                inset 0 0 20px rgba(70, 90, 110, 0.2);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(135, 206, 235, 0.4), transparent);
            transition: left 0.7s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(135, 206, 235, 0.3);
            border-color: rgba(135, 206, 235, 0.9);
            transform: translateY(-6px) scale(1.03);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(135, 206, 235, 0.6),
                inset 0 0 40px rgba(70, 90, 110, 0.3);
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(12px) scale(1.3);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(200, 220, 240, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(135, 206, 235, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(200, 220, 240, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 0 20px rgba(135, 206, 235, 0.8);
            color: #fff;
        }
        
        .heart {
            margin: 0 5px;
            animation: heartBeat 1.5s ease infinite;
        }
        
        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.4); }
            50% { transform: scale(1.2); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="mountain-range">
        <div class="mountain mountain1"></div>
        <div class="mountain mountain2"></div>
        <div class="mountain mountain3"></div>
        <div class="mountain mountain4"></div>
    </div>
    <div class="snow-caps">
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
        <div class="snow"></div>
    </div>
    <div class="clouds">
        <div class="cloud cloud1"></div>
        <div class="cloud cloud2"></div>
        <div class="cloud cloud3"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <p class="bio"><%=dp.bio||"Welcome to my link hub! Explore all my profiles below."%></p>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(26,35,50,0.8)', textColor: '#87ceeb' }) %>
</body>
</html>

