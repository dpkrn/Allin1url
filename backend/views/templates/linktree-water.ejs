<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%=username.toUpperCase()%>'s All in1 url profile">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <title><%=username.toUpperCase()%> - All in1 url</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Montserrat', sans-serif;
            background: linear-gradient(180deg, #0a4d6e 0%, #1e88c7 50%, #64b5f6 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .water-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, #0a4d6e 0%, #1e88c7 50%, #64b5f6 100%);
            z-index: 0;
        }
        
        .wave {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 200%;
            height: 100px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,154.7C960,171,1056,181,1152,165.3C1248,149,1344,107,1392,85.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') repeat-x;
            animation: waveMove 15s linear infinite;
            z-index: 1;
        }
        
        .wave2 {
            bottom: -50px;
            animation: waveMove 20s linear infinite reverse;
            opacity: 0.7;
        }
        
        .wave3 {
            bottom: -100px;
            animation: waveMove 25s linear infinite;
            opacity: 0.5;
        }
        
        @keyframes waveMove {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        
        .bubbles {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .bubble {
            position: absolute;
            bottom: -50px;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            animation: bubbleRise 8s infinite ease-in;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
        
        .bubble:nth-child(1) { left: 10%; animation-delay: 0s; width: 30px; height: 30px; }
        .bubble:nth-child(2) { left: 20%; animation-delay: 2s; width: 50px; height: 50px; }
        .bubble:nth-child(3) { left: 30%; animation-delay: 4s; width: 35px; height: 35px; }
        .bubble:nth-child(4) { left: 40%; animation-delay: 1s; width: 45px; height: 45px; }
        .bubble:nth-child(5) { left: 50%; animation-delay: 3s; width: 40px; height: 40px; }
        .bubble:nth-child(6) { left: 60%; animation-delay: 5s; width: 35px; height: 35px; }
        .bubble:nth-child(7) { left: 70%; animation-delay: 2.5s; width: 50px; height: 50px; }
        .bubble:nth-child(8) { left: 80%; animation-delay: 4.5s; width: 30px; height: 30px; }
        .bubble:nth-child(9) { left: 90%; animation-delay: 1.5s; width: 45px; height: 45px; }
        
        @keyframes bubbleRise {
            0% {
                bottom: -50px;
                transform: translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                bottom: 100vh;
                transform: translateX(50px);
                opacity: 0;
            }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            max-height: 95vh;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 25px 30px;
            box-shadow: 
                0 20px 60px rgba(0, 0, 0, 0.3),
                inset 0 0 50px rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.3);
            animation: floatContainer 6s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes floatContainer {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(1deg); }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 25px;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255, 255, 255, 0.6);
            box-shadow: 
                0 15px 40px rgba(0, 0, 0, 0.3),
                inset 0 0 30px rgba(255, 255, 255, 0.2);
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 2;
            animation: picWave 3s ease-in-out infinite;
        }
        
        @keyframes picWave {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.05); }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 20px 60px rgba(0, 0, 0, 0.4),
                inset 0 0 50px rgba(255, 255, 255, 0.3);
        }
        
        .username {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 12px;
            text-shadow: 
                0 4px 15px rgba(0, 0, 0, 0.3),
                0 0 30px rgba(255, 255, 255, 0.3);
            animation: usernameFlow 4s ease-in-out infinite;
            letter-spacing: 1px;
        }
        
        @keyframes usernameFlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        
        .bio {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.95);
            line-height: 1.8;
            margin-bottom: 30px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 15px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(30px) scale(0.9);
            animation: waterRise 0.7s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes waterRise {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            text-decoration: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            transform: translateY(-50%);
            transition: left 0.6s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(255, 255, 255, 0.3);
            border-color: rgba(255, 255, 255, 0.6);
            transform: translateY(-5px) scale(1.02);
            box-shadow: 
                0 15px 40px rgba(0, 0, 0, 0.3),
                inset 0 0 30px rgba(255, 255, 255, 0.2);
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.4s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(10px) rotate(90deg);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255, 255, 255, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(255, 255, 255, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(255, 255, 255, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 2px 10px rgba(255, 255, 255, 0.5);
        }
        
        .heart {
            margin: 0 5px;
            animation: heartBeat 1.5s ease infinite;
        }
        
        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.4); }
            50% { transform: scale(1.2); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="water-bg"></div>
    <div class="wave"></div>
    <div class="wave wave2"></div>
    <div class="wave wave3"></div>
    <div class="bubbles">
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <div class="profile-pic-wrapper">
                <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            </div>
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <%- include('../partials/profile-info') %>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(255,255,255,0.2)', textColor: 'white' }) %>
</body>
</html>

