<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <%- include('../partials/seo-head') %>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Raleway', sans-serif;
            background: linear-gradient(180deg, #001122 0%, #003366 30%, #004488 60%, #0055aa 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .ocean-waves {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 200px;
            z-index: 0;
        }
        
        .wave {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 200%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23006699" fill-opacity="0.3" d="M0,160L48,154.7C96,149,192,139,288,144C384,149,480,171,576,165.3C672,160,768,128,864,128C960,128,1056,160,1152,154.7C1248,149,1344,107,1392,85.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') repeat-x;
            animation: oceanWave 20s linear infinite;
        }
        
        .wave2 {
            animation: oceanWave 25s linear infinite reverse;
            opacity: 0.6;
            height: 150px;
        }
        
        .wave3 {
            animation: oceanWave 30s linear infinite;
            opacity: 0.4;
            height: 120px;
        }
        
        @keyframes oceanWave {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        
        .bubbles-container {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .bubble {
            position: absolute;
            bottom: -60px;
            width: 50px;
            height: 50px;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.1));
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            animation: bubbleFloat linear infinite;
        }
        
        .bubble:nth-child(1) { left: 10%; animation-duration: 10s; animation-delay: 0s; width: 40px; height: 40px; }
        .bubble:nth-child(2) { left: 25%; animation-duration: 12s; animation-delay: 2s; width: 60px; height: 60px; }
        .bubble:nth-child(3) { left: 40%; animation-duration: 14s; animation-delay: 4s; width: 45px; height: 45px; }
        .bubble:nth-child(4) { left: 55%; animation-duration: 11s; animation-delay: 1s; width: 55px; height: 55px; }
        .bubble:nth-child(5) { left: 70%; animation-duration: 13s; animation-delay: 3s; width: 50px; height: 50px; }
        .bubble:nth-child(6) { left: 85%; animation-duration: 15s; animation-delay: 5s; width: 45px; height: 45px; }
        
        @keyframes bubbleFloat {
            0% {
                bottom: -60px;
                transform: translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            90% {
                opacity: 0.8;
            }
            100% {
                bottom: 100vh;
                transform: translateX(80px);
                opacity: 0;
            }
        }
        
        .fish {
            position: fixed;
            width: 40px;
            height: 30px;
            background: radial-gradient(ellipse, rgba(255, 165, 0, 0.6), rgba(255, 140, 0, 0.3));
            border-radius: 50% 0 50% 50%;
            animation: fishSwim 25s linear infinite;
            z-index: 1;
        }
        
        .fish::before {
            content: '';
            position: absolute;
            width: 10px;
            height: 10px;
            background: #fff;
            border-radius: 50%;
            top: 5px;
            right: 10px;
        }
        
        .fish:nth-child(1) { top: 20%; animation-delay: 0s; }
        .fish:nth-child(2) { top: 60%; animation-delay: 10s; }
        
        @keyframes fishSwim {
            0% { left: -60px; transform: scaleX(1); }
            49% { transform: scaleX(1); }
            50% { transform: scaleX(-1); }
            100% { left: 100vw; transform: scaleX(-1); }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            max-height: 95vh;
            background: rgba(0, 51, 102, 0.4);
            backdrop-filter: blur(25px);
            border-radius: 30px;
            padding: 25px 30px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.5),
                0 0 60px rgba(0, 153, 255, 0.3),
                inset 0 0 50px rgba(0, 102, 204, 0.2);
            border: 2px solid rgba(0, 153, 255, 0.4);
            animation: oceanFloat 8s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes oceanFloat {
            0%, 100% { transform: translateY(0) translateX(0); }
            50% { transform: translateY(-25px) translateX(5px); }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(0, 153, 255, 0.7);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.5),
                0 0 50px rgba(0, 153, 255, 0.5),
                inset 0 0 30px rgba(0, 102, 204, 0.3);
            margin-bottom: 25px;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: picFloat 4s ease-in-out infinite;
        }
        
        @keyframes picFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.05); }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.6),
                0 0 70px rgba(0, 153, 255, 0.7),
                inset 0 0 50px rgba(0, 102, 204, 0.4);
        }
        
        .username {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 12px;
            text-shadow: 
                0 4px 20px rgba(0, 0, 0, 0.6),
                0 0 40px rgba(0, 153, 255, 0.5);
            animation: usernameWave 4s ease-in-out infinite;
            letter-spacing: 2px;
        }
        
        @keyframes usernameWave {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        
        .bio {
            font-size: 16px;
            color: rgba(200, 230, 255, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 16px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(0, 153, 255, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(0, 153, 255, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 153, 255, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(40px) scale(0.9);
            animation: oceanRise 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes oceanRise {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(0, 102, 204, 0.3);
            border: 2px solid rgba(0, 153, 255, 0.5);
            border-radius: 20px;
            text-decoration: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(0, 153, 255, 0.2),
                inset 0 0 20px rgba(0, 102, 204, 0.1);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 153, 255, 0.4), transparent);
            transition: left 0.7s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(0, 153, 255, 0.4);
            border-color: rgba(0, 153, 255, 0.9);
            transform: translateY(-6px) scale(1.03);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.6),
                0 0 60px rgba(0, 153, 255, 0.6),
                inset 0 0 40px rgba(0, 102, 204, 0.3);
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(12px) rotate(90deg);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(200, 230, 255, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(0, 153, 255, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(200, 230, 255, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 0 20px rgba(0, 153, 255, 0.8);
            color: #fff;
        }
        
        .heart {
            margin: 0 5px;
            animation: heartBeat 1.5s ease infinite;
        }
        
        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.4); }
            50% { transform: scale(1.2); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="ocean-waves">
        <div class="wave"></div>
        <div class="wave wave2"></div>
        <div class="wave wave3"></div>
    </div>
    <div class="bubbles-container">
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
    </div>
    <div class="fish"></div>
    <div class="fish"></div>
    
    <div class="container">
        <div class="profile-section">
            <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <%- include('../partials/profile-info') %>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(0,51,102,0.6)', textColor: '#0099ff' }) %>
</body>
</html>

