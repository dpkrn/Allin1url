<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%=username.toUpperCase()%>'s All in1 url profile">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <title><%=username.toUpperCase()%> - All in1 url</title>
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Exo 2', sans-serif;
            background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2a 25%, #2a2a3a 50%, #3a3a4a 75%, #4a4a5a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .clouds-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background: linear-gradient(180deg, #0a0a1a 0%, #1a1a2a 50%, #2a2a3a 100%);
            animation: stormClouds 10s ease-in-out infinite;
        }
        
        @keyframes stormClouds {
            0%, 100% { opacity: 0.8; }
            50% { opacity: 1; }
        }
        
        .cloud {
            position: fixed;
            width: 200px;
            height: 80px;
            background: rgba(100, 100, 120, 0.6);
            border-radius: 100px;
            animation: cloudDrift linear infinite;
        }
        
        .cloud::before {
            content: '';
            position: absolute;
            width: 100px;
            height: 100px;
            background: rgba(100, 100, 120, 0.6);
            border-radius: 50%;
            top: -50px;
            left: 20px;
        }
        
        .cloud::after {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(100, 100, 120, 0.6);
            border-radius: 50%;
            top: -60px;
            right: 20px;
        }
        
        .cloud1 {
            top: 10%;
            animation-duration: 25s;
            animation-delay: 0s;
        }
        
        .cloud2 {
            top: 30%;
            animation-duration: 30s;
            animation-delay: 5s;
        }
        
        .cloud3 {
            top: 50%;
            animation-duration: 35s;
            animation-delay: 10s;
        }
        
        @keyframes cloudDrift {
            0% { left: -250px; }
            100% { left: 100%; }
        }
        
        .lightning {
            position: fixed;
            width: 4px;
            height: 300px;
            background: linear-gradient(to bottom, transparent, #fff, transparent);
            box-shadow: 
                0 0 20px #fff,
                0 0 40px #87ceeb,
                0 0 60px #4da6ff;
            opacity: 0;
            animation: lightning 3s infinite;
            z-index: 1;
        }
        
        .lightning1 {
            left: 20%;
            top: 10%;
            animation-delay: 1s;
            transform: rotate(15deg);
        }
        
        .lightning2 {
            left: 60%;
            top: 20%;
            animation-delay: 4s;
            transform: rotate(-10deg);
        }
        
        .lightning3 {
            left: 80%;
            top: 15%;
            animation-delay: 7s;
            transform: rotate(20deg);
        }
        
        @keyframes lightning {
            0%, 90%, 100% { opacity: 0; }
            91%, 93% { opacity: 1; }
            92% { opacity: 0.8; }
        }
        
        .rain {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .drop {
            position: absolute;
            width: 2px;
            height: 30px;
            background: linear-gradient(to bottom, rgba(200, 200, 255, 0.6), rgba(150, 150, 200, 0.3));
            top: -30px;
            animation: rainFall linear infinite;
        }
        
        .drop:nth-child(1) { left: 10%; animation-duration: 0.8s; animation-delay: 0s; }
        .drop:nth-child(2) { left: 20%; animation-duration: 1s; animation-delay: 0.1s; }
        .drop:nth-child(3) { left: 30%; animation-duration: 0.9s; animation-delay: 0.2s; }
        .drop:nth-child(4) { left: 40%; animation-duration: 1.1s; animation-delay: 0.3s; }
        .drop:nth-child(5) { left: 50%; animation-duration: 0.7s; animation-delay: 0.4s; }
        .drop:nth-child(6) { left: 60%; animation-duration: 1.2s; animation-delay: 0.5s; }
        .drop:nth-child(7) { left: 70%; animation-duration: 0.85s; animation-delay: 0.6s; }
        .drop:nth-child(8) { left: 80%; animation-duration: 1.05s; animation-delay: 0.7s; }
        .drop:nth-child(9) { left: 90%; animation-duration: 0.95s; animation-delay: 0.8s; }
        .drop:nth-child(10) { left: 15%; animation-duration: 1.15s; animation-delay: 0.9s; }
        
        @keyframes rainFall {
            0% {
                top: -30px;
                opacity: 1;
            }
            100% {
                top: 100vh;
                opacity: 0;
            }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 510px;
            max-height: 95vh;
            background: rgba(10, 10, 26, 0.7);
            backdrop-filter: blur(25px);
            border-radius: 25px;
            padding: 25px 30px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.8),
                0 0 60px rgba(135, 206, 235, 0.4),
                inset 0 0 50px rgba(77, 166, 255, 0.2);
            border: 2px solid rgba(135, 206, 235, 0.5);
            animation: stormPulse 2s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes stormPulse {
            0%, 100% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.8),
                    0 0 60px rgba(135, 206, 235, 0.4),
                    inset 0 0 50px rgba(77, 166, 255, 0.2);
            }
            50% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.8),
                    0 0 80px rgba(135, 206, 235, 0.7),
                    inset 0 0 70px rgba(77, 166, 255, 0.4);
            }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(135, 206, 235, 0.7);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.7),
                0 0 50px rgba(135, 206, 235, 0.6),
                inset 0 0 30px rgba(77, 166, 255, 0.3);
            margin-bottom: 25px;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: picStorm 4s ease-in-out infinite;
        }
        
        @keyframes picStorm {
            0%, 100% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.7),
                    0 0 50px rgba(135, 206, 235, 0.6),
                    inset 0 0 30px rgba(77, 166, 255, 0.3);
            }
            50% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.7),
                    0 0 70px rgba(135, 206, 235, 0.9),
                    inset 0 0 50px rgba(77, 166, 255, 0.5);
                transform: scale(1.05);
            }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.9),
                0 0 90px rgba(135, 206, 235, 1),
                inset 0 0 70px rgba(77, 166, 255, 0.7);
        }
        
        .username {
            font-size: 34px;
            font-weight: 900;
            color: #fff;
            margin-bottom: 12px;
            text-shadow: 
                0 4px 20px rgba(0, 0, 0, 0.8),
                0 0 40px rgba(135, 206, 235, 0.6);
            animation: usernameFlash 2s ease-in-out infinite;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        @keyframes usernameFlash {
            0%, 90%, 100% { 
                text-shadow: 
                    0 4px 20px rgba(0, 0, 0, 0.8),
                    0 0 40px rgba(135, 206, 235, 0.6);
            }
            91%, 93% { 
                text-shadow: 
                    0 4px 20px rgba(0, 0, 0, 0.8),
                    0 0 60px rgba(255, 255, 255, 1),
                    0 0 80px rgba(135, 206, 235, 0.9);
            }
            92% { 
                text-shadow: 
                    0 4px 20px rgba(0, 0, 0, 0.8),
                    0 0 50px rgba(135, 206, 235, 0.7);
            }
        }
        
        .bio {
            font-size: 17px;
            color: rgba(200, 220, 255, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 
                0 2px 15px rgba(0, 0, 0, 0.7),
                0 0 20px rgba(135, 206, 235, 0.4);
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 16px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(135, 206, 235, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(135, 206, 235, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(135, 206, 235, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(40px) scale(0.9);
            animation: stormAppear 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes stormAppear {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(77, 166, 255, 0.2);
            border: 2px solid rgba(135, 206, 235, 0.6);
            border-radius: 18px;
            text-decoration: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.6),
                0 0 30px rgba(135, 206, 235, 0.3),
                inset 0 0 20px rgba(77, 166, 255, 0.2);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(135, 206, 235, 0.5), transparent);
            transition: left 0.7s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(135, 206, 235, 0.4);
            border-color: rgba(135, 206, 235, 0.9);
            transform: translateY(-6px) scale(1.03);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.7),
                0 0 70px rgba(135, 206, 235, 0.8),
                inset 0 0 50px rgba(77, 166, 255, 0.4);
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(12px) scale(1.3);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(200, 220, 255, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(135, 206, 235, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(200, 220, 255, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 0 25px rgba(135, 206, 235, 0.9);
            color: #fff;
        }
        
        .heart {
            margin: 0 5px;
            animation: stormHeart 1.5s ease infinite;
        }
        
        @keyframes stormHeart {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(135, 206, 235, 0.5)); }
            25% { transform: scale(1.5); filter: drop-shadow(0 0 15px rgba(135, 206, 235, 0.9)); }
            50% { transform: scale(1.3); filter: drop-shadow(0 0 10px rgba(135, 206, 235, 0.7)); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="clouds-bg"></div>
    <div class="cloud cloud1"></div>
    <div class="cloud cloud2"></div>
    <div class="cloud cloud3"></div>
    <div class="lightning lightning1"></div>
    <div class="lightning lightning2"></div>
    <div class="lightning lightning3"></div>
    <div class="rain">
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
        <div class="drop"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <%- include('../partials/profile-info') %>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(10,10,26,0.8)', textColor: '#87ceeb' }) %>
</body>
</html>

