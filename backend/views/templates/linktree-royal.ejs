<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <%- include('../partials/seo-head') %>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Cormorant+Garamond:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Cinzel', serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #2d1b3d 25%, #4a2c5a 50%, #6b3d7a 75%, #8b4d9a 100%);
            background-size: 400% 400%;
            animation: royalGradient 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        @keyframes royalGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        .crown-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.05;
            background-image: 
                repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255, 215, 0, 0.1) 2px, rgba(255, 215, 0, 0.1) 4px),
                repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(255, 215, 0, 0.1) 2px, rgba(255, 215, 0, 0.1) 4px);
            background-size: 60px 60px;
            z-index: 0;
        }
        
        .sparkles {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .sparkle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: #ffd700;
            border-radius: 50%;
            box-shadow: 0 0 10px #ffd700;
            animation: sparkleFloat 6s infinite ease-in-out;
        }
        
        .sparkle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
        .sparkle:nth-child(2) { left: 30%; top: 60%; animation-delay: 1s; }
        .sparkle:nth-child(3) { left: 50%; top: 30%; animation-delay: 2s; }
        .sparkle:nth-child(4) { left: 70%; top: 70%; animation-delay: 3s; }
        .sparkle:nth-child(5) { left: 90%; top: 40%; animation-delay: 4s; }
        .sparkle:nth-child(6) { left: 20%; top: 80%; animation-delay: 5s; }
        .sparkle:nth-child(7) { left: 60%; top: 15%; animation-delay: 0.5s; }
        .sparkle:nth-child(8) { left: 80%; top: 55%; animation-delay: 1.5s; }
        
        @keyframes sparkleFloat {
            0%, 100% {
                transform: translateY(0) scale(1);
                opacity: 0;
            }
            50% {
                transform: translateY(-30px) scale(1.5);
                opacity: 1;
            }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 520px;
            max-height: 95vh;
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.8) 0%, rgba(45, 27, 61, 0.8) 100%);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 30px 35px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.5),
                0 0 50px rgba(255, 215, 0, 0.2),
                inset 0 0 60px rgba(255, 215, 0, 0.1);
            border: 3px solid rgba(255, 215, 0, 0.4);
            animation: royalGlow 4s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes royalGlow {
            0%, 100% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.5),
                    0 0 50px rgba(255, 215, 0, 0.2),
                    inset 0 0 60px rgba(255, 215, 0, 0.1);
            }
            50% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.5),
                    0 0 80px rgba(255, 215, 0, 0.4),
                    inset 0 0 80px rgba(255, 215, 0, 0.2);
            }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 25px;
        }
        
        .profile-pic-wrapper::before {
            content: '👑';
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 40px;
            animation: crownFloat 3s ease-in-out infinite;
            z-index: 3;
            filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.8));
        }
        
        @keyframes crownFloat {
            0%, 100% { transform: translateX(-50%) translateY(0) rotate(-5deg); }
            50% { transform: translateX(-50%) translateY(-10px) rotate(5deg); }
        }
        
        .profile-pic {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255, 215, 0, 0.8);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.5),
                0 0 40px rgba(255, 215, 0, 0.6),
                inset 0 0 30px rgba(255, 215, 0, 0.2);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 2;
            animation: picPulse 4s ease-in-out infinite;
        }
        
        @keyframes picPulse {
            0%, 100% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.5),
                    0 0 40px rgba(255, 215, 0, 0.6),
                    inset 0 0 30px rgba(255, 215, 0, 0.2);
            }
            50% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.5),
                    0 0 60px rgba(255, 215, 0, 0.8),
                    inset 0 0 40px rgba(255, 215, 0, 0.3);
            }
        }
        
        .profile-pic:hover {
            transform: scale(1.15) rotate(360deg);
            border-color: rgba(255, 215, 0, 1);
        }
        
        .username {
            font-size: 36px;
            font-weight: 900;
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #ffd700 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 15px;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
            animation: goldShine 3s linear infinite;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        
        @keyframes goldShine {
            to { background-position: 200% center; }
        }
        
        .bio {
            font-size: 17px;
            color: rgba(255, 240, 200, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 18px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 215, 0, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(255, 215, 0, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 215, 0, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(30px) scale(0.9);
            animation: royalAppear 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes royalAppear {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 18px 26px;
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.15) 0%, rgba(255, 223, 0, 0.1) 100%);
            border: 2px solid rgba(255, 215, 0, 0.5);
            border-radius: 20px;
            text-decoration: none;
            color: #ffd700;
            font-weight: 700;
            font-size: 17px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.4),
                inset 0 0 20px rgba(255, 215, 0, 0.1);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.4), transparent);
            transition: left 0.7s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.3) 0%, rgba(255, 223, 0, 0.2) 100%);
            border-color: rgba(255, 215, 0, 0.9);
            transform: translateY(-6px) scale(1.03);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.5),
                0 0 40px rgba(255, 215, 0, 0.6),
                inset 0 0 30px rgba(255, 215, 0, 0.2);
            color: #fff;
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
            font-size: 22px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(12px) scale(1.3);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255, 240, 200, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(255, 215, 0, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(255, 215, 0, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 2px 15px rgba(255, 215, 0, 0.8);
            color: #ffd700;
        }
        
        .heart {
            margin: 0 5px;
            animation: royalHeart 1.5s ease infinite;
        }
        
        @keyframes royalHeart {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.5)); }
            25% { transform: scale(1.5); filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.8)); }
            50% { transform: scale(1.3); filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.6)); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 25px 20px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 100px; height: 100px; }
            .username { font-size: 26px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="crown-pattern"></div>
    <div class="sparkles">
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
        <div class="sparkle"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <div class="profile-pic-wrapper">
                <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            </div>
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <%- include('../partials/profile-info') %>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(26,26,46,0.8)', textColor: '#ffd700' }) %>
</body>
</html>

