<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <%- include('../partials/seo-head') %>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&family=Playfair+Display:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Playfair Display', serif;
            background: linear-gradient(180deg, #1a3d1a 0%, #2d5a2d 30%, #3d7a3d 60%, #4a8c4a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .forest-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, #1a3d1a 0%, #2d5a2d 30%, #3d7a3d 60%, #4a8c4a 100%);
            z-index: 0;
        }
        
        .leaves-container {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .leaf {
            position: absolute;
            width: 30px;
            height: 30px;
            background: rgba(76, 175, 80, 0.6);
            border-radius: 0 100% 0 100%;
            transform: rotate(45deg);
            animation: leafFall linear infinite;
            opacity: 0.8;
        }
        
        .leaf::before {
            content: '';
            position: absolute;
            width: 15px;
            height: 15px;
            background: rgba(129, 199, 132, 0.8);
            border-radius: 0 100% 0 100%;
            top: -5px;
            left: 5px;
        }
        
        .leaf:nth-child(1) { left: 10%; animation-duration: 8s; animation-delay: 0s; }
        .leaf:nth-child(2) { left: 20%; animation-duration: 10s; animation-delay: 2s; }
        .leaf:nth-child(3) { left: 30%; animation-duration: 12s; animation-delay: 4s; }
        .leaf:nth-child(4) { left: 40%; animation-duration: 9s; animation-delay: 1s; }
        .leaf:nth-child(5) { left: 50%; animation-duration: 11s; animation-delay: 3s; }
        .leaf:nth-child(6) { left: 60%; animation-duration: 13s; animation-delay: 5s; }
        .leaf:nth-child(7) { left: 70%; animation-duration: 10s; animation-delay: 2.5s; }
        .leaf:nth-child(8) { left: 80%; animation-duration: 14s; animation-delay: 6s; }
        .leaf:nth-child(9) { left: 90%; animation-duration: 9s; animation-delay: 1.5s; }
        
        @keyframes leafFall {
            0% {
                top: -50px;
                transform: rotate(45deg) translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            90% {
                opacity: 0.8;
            }
            100% {
                top: 100vh;
                transform: rotate(405deg) translateX(100px);
                opacity: 0;
            }
        }
        
        .sunrays {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 30% 20%, rgba(255, 235, 59, 0.2) 0%, transparent 50%);
            animation: raysMove 15s ease-in-out infinite;
            z-index: 1;
        }
        
        @keyframes raysMove {
            0%, 100% { opacity: 0.3; transform: rotate(0deg); }
            50% { opacity: 0.5; transform: rotate(5deg); }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            max-height: 95vh;
            background: rgba(30, 60, 30, 0.4);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 25px 30px;
            box-shadow: 
                0 20px 60px rgba(0, 0, 0, 0.4),
                inset 0 0 50px rgba(76, 175, 80, 0.1);
            border: 2px solid rgba(76, 175, 80, 0.3);
            animation: forestSway 8s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes forestSway {
            0%, 100% { transform: translateX(0) rotate(0deg); }
            50% { transform: translateX(3px) rotate(0.5deg); }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(129, 199, 132, 0.6);
            box-shadow: 
                0 15px 40px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(76, 175, 80, 0.3);
            margin-bottom: 25px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: picGrow 4s ease-in-out infinite;
        }
        
        @keyframes picGrow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 20px 60px rgba(0, 0, 0, 0.5),
                0 0 50px rgba(129, 199, 132, 0.5);
            border-color: rgba(129, 199, 132, 0.9);
        }
        
        .username {
            font-size: 34px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 12px;
            text-shadow: 
                0 4px 15px rgba(0, 0, 0, 0.5),
                0 0 30px rgba(255, 235, 59, 0.3);
            animation: textGlow 3s ease-in-out infinite;
            letter-spacing: 2px;
            font-style: italic;
        }
        
        @keyframes textGlow {
            0%, 100% { text-shadow: 0 4px 15px rgba(0, 0, 0, 0.5), 0 0 30px rgba(255, 235, 59, 0.3); }
            50% { text-shadow: 0 4px 15px rgba(0, 0, 0, 0.5), 0 0 50px rgba(255, 235, 59, 0.5); }
        }
        
        .bio {
            font-size: 17px;
            color: rgba(200, 230, 200, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
            font-family: 'Crimson Text', serif;
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 15px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(129, 199, 132, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(129, 199, 132, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(129, 199, 132, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(30px) scale(0.9);
            animation: growUp 0.7s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes growUp {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(30, 60, 30, 0.5);
            border: 2px solid rgba(129, 199, 132, 0.5);
            border-radius: 18px;
            text-decoration: none;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(129, 199, 132, 0.3), transparent);
            transition: left 0.6s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(76, 175, 80, 0.4);
            border-color: rgba(129, 199, 132, 0.8);
            transform: translateY(-5px) scale(1.03);
            box-shadow: 
                0 15px 40px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(129, 199, 132, 0.4);
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.4s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(10px) scale(1.2);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(200, 230, 200, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(129, 199, 132, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(200, 230, 200, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 2px 10px rgba(129, 199, 132, 0.5);
        }
        
        .heart {
            margin: 0 5px;
            animation: heartBeat 1.5s ease infinite;
        }
        
        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            25% { transform: scale(1.4); }
            50% { transform: scale(1.2); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="forest-bg"></div>
    <div class="sunrays"></div>
    <div class="leaves-container">
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <%- include('../partials/profile-info') %>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" style="animation-delay: <%= delay %>s;">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(30,60,30,0.6)', textColor: '#81c784' }) %>
</body>
</html>

