<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%=username.toUpperCase()%>'s All in1 url profile">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <title><%=username.toUpperCase()%> - All in1 url</title>
    <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&family=Uncial+Antiqua&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Uncial Antiqua', cursive;
            background: linear-gradient(135deg, #1a0033 0%, #330066 25%, #4d0099 50%, #6600cc 75%, #7f00ff 100%);
            background-size: 400% 400%;
            animation: mysticalGradient 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        @keyframes mysticalGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        .mystical-orbs {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }
        
        .orb {
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255, 0, 255, 0.6), rgba(138, 43, 226, 0.3), transparent);
            box-shadow: 
                0 0 50px rgba(255, 0, 255, 0.8),
                inset 0 0 50px rgba(138, 43, 226, 0.5);
            animation: orbFloat 10s ease-in-out infinite;
        }
        
        .orb1 {
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }
        
        .orb2 {
            top: 60%;
            right: 15%;
            animation-delay: 3s;
            width: 200px;
            height: 200px;
        }
        
        .orb3 {
            bottom: 20%;
            left: 20%;
            animation-delay: 6s;
            width: 120px;
            height: 120px;
        }
        
        @keyframes orbFloat {
            0%, 100% { 
                transform: translate(0, 0) scale(1);
                opacity: 0.6;
            }
            50% { 
                transform: translate(50px, -50px) scale(1.2);
                opacity: 1;
            }
        }
        
        .magic-particles {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .particle {
            position: absolute;
            width: 8px;
            height: 8px;
            background: radial-gradient(circle, rgba(255, 0, 255, 1), rgba(138, 43, 226, 0.5));
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(255, 0, 255, 1);
            animation: particleFloat linear infinite;
        }
        
        .particle:nth-child(1) { left: 10%; top: 20%; animation-duration: 8s; animation-delay: 0s; }
        .particle:nth-child(2) { left: 25%; top: 50%; animation-duration: 10s; animation-delay: 2s; }
        .particle:nth-child(3) { left: 40%; top: 30%; animation-duration: 12s; animation-delay: 4s; }
        .particle:nth-child(4) { left: 55%; top: 70%; animation-duration: 9s; animation-delay: 1s; }
        .particle:nth-child(5) { left: 70%; top: 40%; animation-duration: 11s; animation-delay: 3s; }
        .particle:nth-child(6) { left: 85%; top: 60%; animation-duration: 13s; animation-delay: 5s; }
        
        @keyframes particleFloat {
            0% {
                transform: translate(0, 0) scale(1);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translate(100px, -100px) scale(1.5);
                opacity: 0;
            }
        }
        
        .rune-circle {
            position: fixed;
            top: 50%;
            left: 50%;
            width: 500px;
            height: 500px;
            transform: translate(-50%, -50%);
            border: 3px solid rgba(255, 0, 255, 0.3);
            border-radius: 50%;
            z-index: 0;
            animation: runeRotate 20s linear infinite;
            box-shadow: 0 0 100px rgba(255, 0, 255, 0.3);
        }
        
        .rune-circle::before {
            content: '✦';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 40px;
            color: rgba(255, 0, 255, 0.6);
            animation: runePulse 2s ease-in-out infinite;
        }
        
        .rune-circle::after {
            content: '✦';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 40px;
            color: rgba(138, 43, 226, 0.6);
            animation: runePulse 2s ease-in-out infinite reverse;
        }
        
        @keyframes runeRotate {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }
        
        @keyframes runePulse {
            0%, 100% { opacity: 0.4; transform: translateX(-50%) scale(1); }
            50% { opacity: 1; transform: translateX(-50%) scale(1.3); }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 530px;
            max-height: 95vh;
            background: rgba(26, 0, 51, 0.7);
            backdrop-filter: blur(30px);
            border-radius: 30px;
            padding: 30px 35px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.8),
                0 0 100px rgba(255, 0, 255, 0.5),
                inset 0 0 80px rgba(138, 43, 226, 0.3);
            border: 3px solid rgba(255, 0, 255, 0.6);
            animation: mysticalGlow 3s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes mysticalGlow {
            0%, 100% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.8),
                    0 0 100px rgba(255, 0, 255, 0.5),
                    inset 0 0 80px rgba(138, 43, 226, 0.3);
                border-color: rgba(255, 0, 255, 0.6);
            }
            50% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.8),
                    0 0 120px rgba(255, 0, 255, 0.8),
                    inset 0 0 100px rgba(138, 43, 226, 0.5);
                border-color: rgba(138, 43, 226, 0.9);
            }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 25px;
        }
        
        .profile-pic-wrapper::before {
            content: '✨';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 30px;
            animation: sparkle 2s ease-in-out infinite;
            z-index: 3;
            filter: drop-shadow(0 0 10px rgba(255, 0, 255, 0.8));
        }
        
        @keyframes sparkle {
            0%, 100% { transform: translateX(-50%) translateY(0) rotate(0deg) scale(1); opacity: 0.6; }
            50% { transform: translateX(-50%) translateY(-10px) rotate(180deg) scale(1.5); opacity: 1; }
        }
        
        .profile-pic {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255, 0, 255, 0.8);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.7),
                0 0 60px rgba(255, 0, 255, 0.8),
                inset 0 0 40px rgba(138, 43, 226, 0.5);
            margin-bottom: 25px;
            transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 2;
            animation: picMystical 4s ease-in-out infinite;
        }
        
        @keyframes picMystical {
            0%, 100% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.7),
                    0 0 60px rgba(255, 0, 255, 0.8),
                    inset 0 0 40px rgba(138, 43, 226, 0.5);
            }
            50% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.7),
                    0 0 90px rgba(255, 0, 255, 1),
                    inset 0 0 60px rgba(138, 43, 226, 0.7);
                transform: scale(1.08) rotate(5deg);
            }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.9),
                0 0 120px rgba(255, 0, 255, 1),
                inset 0 0 80px rgba(138, 43, 226, 0.8);
        }
        
        .username {
            font-size: 38px;
            font-weight: 900;
            background: linear-gradient(135deg, #ff00ff 0%, #9370db 25%, #8a2be2 50%, #9370db 75%, #ff00ff 100%);
            background-size: 300% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 15px;
            animation: mysticalText 5s linear infinite;
            letter-spacing: 4px;
            text-transform: uppercase;
            filter: drop-shadow(0 0 20px rgba(255, 0, 255, 0.8));
        }
        
        @keyframes mysticalText {
            to { background-position: 300% center; }
        }
        
        .bio {
            font-size: 18px;
            color: rgba(255, 200, 255, 0.95);
            line-height: 2;
            margin-bottom: 30px;
            text-shadow: 
                0 2px 15px rgba(0, 0, 0, 0.7),
                0 0 30px rgba(255, 0, 255, 0.5);
            font-family: 'MedievalSharp', cursive;
            font-style: italic;
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 18px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 0, 255, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(255, 0, 255, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 0, 255, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(40px) scale(0.8);
            animation: mysticalAppear 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes mysticalAppear {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 18px 28px;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3) 0%, rgba(255, 0, 255, 0.2) 100%);
            border: 3px solid rgba(255, 0, 255, 0.6);
            border-radius: 22px;
            text-decoration: none;
            color: #ffb3ff;
            font-weight: 700;
            font-size: 18px;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 3px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.6),
                0 0 40px rgba(255, 0, 255, 0.4),
                inset 0 0 30px rgba(138, 43, 226, 0.2);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 0, 255, 0.6), transparent);
            transition: left 0.8s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.5) 0%, rgba(255, 0, 255, 0.4) 100%);
            border-color: rgba(255, 0, 255, 1);
            transform: translateY(-8px) scale(1.04);
            box-shadow: 
                0 25px 60px rgba(0, 0, 0, 0.8),
                0 0 100px rgba(255, 0, 255, 0.9),
                inset 0 0 60px rgba(138, 43, 226, 0.4);
            color: #fff;
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.6s ease;
            font-size: 24px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(15px) scale(1.5) rotate(45deg);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255, 200, 255, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 3px solid rgba(255, 0, 255, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(255, 200, 255, 0.9);
            font-size: 14px;
            transition: all 0.3s ease;
            font-family: 'MedievalSharp', cursive;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 0 30px rgba(255, 0, 255, 0.9);
            color: #ffb3ff;
        }
        
        .heart {
            margin: 0 5px;
            animation: mysticalHeart 1.5s ease infinite;
        }
        
        @keyframes mysticalHeart {
            0%, 100% { 
                transform: scale(1) rotate(0deg); 
                filter: drop-shadow(0 0 8px rgba(255, 0, 255, 0.6)); 
            }
            25% { 
                transform: scale(1.6) rotate(10deg); 
                filter: drop-shadow(0 0 20px rgba(255, 0, 255, 1)); 
            }
            50% { 
                transform: scale(1.4) rotate(-10deg); 
                filter: drop-shadow(0 0 15px rgba(138, 43, 226, 0.9)); 
            }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 25px 20px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 100px; height: 100px; }
            .username { font-size: 28px; }
            .bio { font-size: 15px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="mystical-orbs">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>
    </div>
    <div class="magic-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>
    <div class="rune-circle"></div>
    
    <div class="container">
        <div class="profile-section">
            <div class="profile-pic-wrapper">
                <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            </div>
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <p class="bio"><%=dp.bio||"Welcome to my link hub! Explore all my profiles below."%></p>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(26,0,51,0.8)', textColor: '#ff00ff' }) %>
</body>
</html>

