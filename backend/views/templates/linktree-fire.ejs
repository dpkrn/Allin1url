<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%=username.toUpperCase()%>'s All in1 url profile">
    <link rel="icon" type="image/png" id="dynamic-favicon" href="/images/panda.png" />
    <title><%=username.toUpperCase()%> - All in1 url</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Oswald', sans-serif;
            background: linear-gradient(180deg, #1a0000 0%, #330000 30%, #660000 60%, #990000 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        
        .flames-bg {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 300px;
            z-index: 0;
        }
        
        .flame {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, #ff6600 0%, #ff3300 40%, #cc0000 70%, transparent 100%);
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            animation: flicker 0.5s ease-in-out infinite alternate;
            opacity: 0.8;
        }
        
        .flame2 {
            animation: flicker2 0.7s ease-in-out infinite alternate;
            opacity: 0.6;
            height: 250px;
            left: -50px;
            width: 110%;
        }
        
        .flame3 {
            animation: flicker3 0.6s ease-in-out infinite alternate;
            opacity: 0.5;
            height: 200px;
            left: 50px;
            width: 90%;
        }
        
        @keyframes flicker {
            0% { transform: scaleY(1) scaleX(1) skewX(2deg); }
            100% { transform: scaleY(1.1) scaleX(1.05) skewX(-2deg); }
        }
        
        @keyframes flicker2 {
            0% { transform: scaleY(1) scaleX(1) skewX(-3deg); }
            100% { transform: scaleY(1.15) scaleX(1.1) skewX(3deg); }
        }
        
        @keyframes flicker3 {
            0% { transform: scaleY(1) scaleX(1) skewX(1deg); }
            100% { transform: scaleY(1.08) scaleX(1.03) skewX(-1deg); }
        }
        
        .embers {
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .ember {
            position: absolute;
            bottom: 0;
            width: 8px;
            height: 8px;
            background: radial-gradient(circle, #ff9900, #ff6600);
            border-radius: 50%;
            box-shadow: 0 0 10px #ff6600;
            animation: emberRise linear infinite;
        }
        
        .ember:nth-child(1) { left: 10%; animation-duration: 8s; animation-delay: 0s; }
        .ember:nth-child(2) { left: 25%; animation-duration: 10s; animation-delay: 2s; }
        .ember:nth-child(3) { left: 40%; animation-duration: 12s; animation-delay: 4s; }
        .ember:nth-child(4) { left: 55%; animation-duration: 9s; animation-delay: 1s; }
        .ember:nth-child(5) { left: 70%; animation-duration: 11s; animation-delay: 3s; }
        .ember:nth-child(6) { left: 85%; animation-duration: 13s; animation-delay: 5s; }
        
        @keyframes emberRise {
            0% {
                bottom: 0;
                transform: translateX(0);
                opacity: 1;
            }
            50% {
                opacity: 0.8;
            }
            100% {
                bottom: 100vh;
                transform: translateX(50px);
                opacity: 0;
            }
        }
        
        .container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 510px;
            max-height: 95vh;
            background: rgba(26, 0, 0, 0.7);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 25px 30px;
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.7),
                0 0 60px rgba(255, 102, 0, 0.5),
                inset 0 0 50px rgba(204, 0, 0, 0.3);
            border: 2px solid rgba(255, 102, 0, 0.6);
            animation: fireGlow 2s ease-in-out infinite;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        @keyframes fireGlow {
            0%, 100% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.7),
                    0 0 60px rgba(255, 102, 0, 0.5),
                    inset 0 0 50px rgba(204, 0, 0, 0.3);
            }
            50% {
                box-shadow: 
                    0 25px 70px rgba(0, 0, 0, 0.7),
                    0 0 80px rgba(255, 102, 0, 0.7),
                    inset 0 0 60px rgba(204, 0, 0, 0.4);
            }
        }
        
        .profile-section {
            text-align: center;
            margin-bottom: 25px;
            flex-shrink: 0;
        }
        
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255, 102, 0, 0.8);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.6),
                0 0 50px rgba(255, 102, 0, 0.7),
                inset 0 0 30px rgba(204, 0, 0, 0.4);
            margin-bottom: 25px;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: picFire 3s ease-in-out infinite;
        }
        
        @keyframes picFire {
            0%, 100% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.6),
                    0 0 50px rgba(255, 102, 0, 0.7),
                    inset 0 0 30px rgba(204, 0, 0, 0.4);
            }
            50% { 
                box-shadow: 
                    0 20px 50px rgba(0, 0, 0, 0.6),
                    0 0 70px rgba(255, 102, 0, 0.9),
                    inset 0 0 40px rgba(204, 0, 0, 0.5);
                transform: scale(1.05);
            }
        }
        
        .profile-pic:hover {
            transform: scale(1.2) rotate(360deg);
            box-shadow: 
                0 25px 70px rgba(0, 0, 0, 0.8),
                0 0 90px rgba(255, 102, 0, 1),
                inset 0 0 60px rgba(204, 0, 0, 0.6);
        }
        
        .username {
            font-size: 34px;
            font-weight: 800;
            background: linear-gradient(180deg, #ff9900 0%, #ff6600 50%, #ff3300 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
            animation: fireText 3s linear infinite;
            letter-spacing: 2px;
            text-transform: uppercase;
            filter: drop-shadow(0 0 10px rgba(255, 102, 0, 0.8));
        }
        
        @keyframes fireText {
            0%, 100% { background-position: 0% center; }
            50% { background-position: 100% center; }
        }
        
        .bio {
            font-size: 17px;
            color: rgba(255, 200, 150, 0.95);
            line-height: 1.9;
            margin-bottom: 30px;
            text-shadow: 
                0 2px 15px rgba(0, 0, 0, 0.6),
                0 0 20px rgba(255, 102, 0, 0.4);
        }
        
        .links {
            display: flex;
            flex-direction: column;
            gap: 16px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 102, 0, 0.3) transparent;
        }
        
        .links::-webkit-scrollbar {
            width: 6px;
        }
        
        .links::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .links::-webkit-scrollbar-thumb {
            background: rgba(255, 102, 0, 0.3);
            border-radius: 3px;
        }
        
        .links::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 102, 0, 0.5);
        }
        
        .link-item {
            opacity: 0;
            transform: translateY(40px) scale(0.9);
            animation: fireAppear 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        
        @keyframes fireAppear {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 16px 24px;
            background: rgba(204, 0, 0, 0.3);
            border: 2px solid rgba(255, 102, 0, 0.6);
            border-radius: 18px;
            text-decoration: none;
            color: #ff9900;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.5),
                0 0 30px rgba(255, 102, 0, 0.3),
                inset 0 0 20px rgba(204, 0, 0, 0.2);
        }
        
        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 102, 0, 0.5), transparent);
            transition: left 0.7s;
        }
        
        .btn:hover::before {
            left: 100%;
        }
        
        .btn:hover {
            background: rgba(255, 102, 0, 0.4);
            border-color: rgba(255, 102, 0, 0.9);
            transform: translateY(-6px) scale(1.03);
            box-shadow: 
                0 20px 50px rgba(0, 0, 0, 0.7),
                0 0 60px rgba(255, 102, 0, 0.7),
                inset 0 0 40px rgba(204, 0, 0, 0.3);
            color: #fff;
        }
        
        .btn-text {
            position: relative;
            z-index: 1;
        }
        
        .btn-arrow {
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
            font-size: 20px;
        }
        
        .btn:hover .btn-arrow {
            transform: translateX(12px) scale(1.3);
        }
        
        .no-links {
            text-align: center;
            padding: 40px 20px;
            color: rgba(255, 200, 150, 0.8);
        }
        
        .footer {
            text-align: center;
            padding-top: 20px;
            margin-top: 10px;
            border-top: 2px solid rgba(255, 102, 0, 0.3);
            flex-shrink: 0;
            visibility: visible;
            opacity: 1;
        }
        
        .website {
            text-decoration: none;
            color: rgba(255, 200, 150, 0.9);
            font-size: 13px;
            transition: all 0.3s ease;
        }
        
        .website:hover {
            transform: scale(1.1);
            text-shadow: 0 0 20px rgba(255, 102, 0, 0.8);
            color: #ff9900;
        }
        
        .heart {
            margin: 0 5px;
            animation: fireHeart 1.5s ease infinite;
        }
        
        @keyframes fireHeart {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 5px rgba(255, 102, 0, 0.5)); }
            25% { transform: scale(1.5); filter: drop-shadow(0 0 15px rgba(255, 102, 0, 0.8)); }
            50% { transform: scale(1.3); filter: drop-shadow(0 0 10px rgba(255, 102, 0, 0.6)); }
        }
        
        @media (max-width: 480px) {
            body { padding: 10px; }
            .container { padding: 20px 15px; max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .links { gap: 12px; margin-bottom: 15px; }
        }
        
        @media (max-height: 600px) {
            .container { max-height: 98vh; }
            .profile-section { margin-bottom: 15px; }
            .profile-pic { width: 90px; height: 90px; }
            .username { font-size: 24px; }
            .bio { font-size: 14px; margin-bottom: 15px; }
        }
    </style>
</head>
<body>
    <div class="flames-bg">
        <div class="flame"></div>
        <div class="flame flame2"></div>
        <div class="flame flame3"></div>
    </div>
    <div class="embers">
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
        <div class="ember"></div>
    </div>
    
    <div class="container">
        <div class="profile-section">
            <img src="<%=dp.image%>" alt="<%=username.toUpperCase()%>'s Profile" class="profile-pic" onerror="handleImageError(this, '<%=username.charAt(0).toUpperCase()%>')">
            <h1 class="username"><%= username.toUpperCase() %></h1>
            <p class="bio"><%=dp.bio||"Welcome to my link hub! Explore all my profiles below."%></p>
        </div>
        
        <div class="links">
            <% if (tree && tree.length > 0) { %>
                <% tree.forEach((item, index) => { 
                    const delay = index * 0.1;
                    %>
                    <div class="link-item" data-delay="<%= delay %>">
                        <a href="<%= getUserLinkUrl(item.username, item.source) %>" class="btn" rel="noopener noreferrer" target="_self">
                            <span class="btn-text"><%= item.source.toUpperCase() %></span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-links">
                    <p>No links available yet.</p>
                </div>
            <% } %>
        </div>
        
        <div class="footer">
            <a class="website" href="https://allin1url.in" target="_blank">
                <span>Made with</span>
                <span class="heart">❤️</span>
                <span>by All in1 url</span>
            </a>
        </div>
    </div>

    <%- getTemplateScripts({ bgColor: 'rgba(26,0,0,0.8)', textColor: '#ff6600' }) %>
</body>
</html>

